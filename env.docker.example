# Environment variables for Docker development
# Copy this file to .env.docker and update with your actual values

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgresql://pison_user:pison_dev_password@db:5432/pison_db

# ================================
# Supabase Configuration
# ================================
# Option 1: Using Supabase Cloud (replace with your project values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Option 2: Using Local Supabase (if running supabase service in docker-compose)
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ================================
# Next.js Configuration
# ================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ================================
# Application Specific
# ================================
# Add any other environment variables your app needs here
# Copy from your .env.local file
