# Prisma Config #
DATABASE_URL=postgresql://postgres:1234567890@localhost:5432/dcm_db
DIRECT_URL=postgresql://postgres:1234567890@localhost:5432/dcm_db

# Redis (optional – app runs without Redis if unset; cache calls no-op)
REDIS_URL=redis://localhost:6379

# Commission cron (self-hosted only; set ENABLE_COMMISSION_CRON=1 and CRON_SECRET to enable)
# ENABLE_COMMISSION_CRON=1
# Monthly maintenance fee cron (daily check; billing day from System settings). Same CRON_SECRET.
# ENABLE_MAINTENANCE_FEE_CRON=1
# CRON_SECRET=your_secure_random_string

# Next Auth Config #
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BASE_PATH=/
NEXTAUTH_URL=http://localhost:3000/
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
GOOGLE_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth2_secret_key

# Storage Configuration (AWS S3 or DigitalOcean Spaces)
STORAGE_TYPE=digitalocean

STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_access_key
STORAGE_REGION=ams3
STORAGE_BUCKET=your_bucket_name
STORAGE_ENDPOINT=your_endpoint
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CDN_URL=your_cdn_url

# SMTP Credentials
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_SECURE=false
SMTP_USER=no-reply@domain.com
SMTP_PASS=your_smtp_pass

# TanStack Query: default background refetch interval for active queries (milliseconds)
# NEXT_PUBLIC_QUERY_REFETCH_INTERVAL_MS=60000

# Additional Optional Settings
SMTP_SENDER=INNOVATE CREDIT
SMTP_FROM=no-reply@domain.com

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_public_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
# Base URL
BASE_URL=/

# Web Push (browser notifications for pending transactions)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BOzIFTgWljFCRD8gtGqJ66aeROAs-zdqe-WsT02ujXe9oft2KmMx6RfKOJfqqFpRW-0stH2E-qGrhJNBCEmhV_U
