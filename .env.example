# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth — random string, min 32 chars (openssl rand -hex 32)
AUTH_SESSION_SECRET=

# App URL for PDF generation (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: Puppeteer Chrome path on Windows/Linux servers
PUPPETEER_EXECUTABLE_PATH=

# Optional defaults
NEXT_PUBLIC_ACADEMIC_YEAR=2024-2025
NEXT_PUBLIC_ENABLE_TEST_PAGES=false
