generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  username            String?     @unique
  password            String?
  country             String?
  timezone            String?
  name                String?
  roleId              String
  status              UserStatus  @default(INACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lastSignInAt        DateTime?
  emailVerifiedAt     DateTime?
  isTrashed           Boolean     @default(false)
  avatar              String?
  invitedByUserId     String?
  isProtected         Boolean     @default(false)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  accounts            Account[]
  Session             Session[]
  systemLog           SystemLog[]
  role                UserRole    @relation(fields: [roleId], references: [id])

  // Microfinance-specific relations
  agent                Agent?
  createdClients       Client[]           @relation("ClientCreator")
  updatedClients       Client[]           @relation("ClientUpdater")
  createdAgents        Agent[]            @relation("AgentCreator")
  updatedAgents        Agent[]            @relation("AgentUpdater")
  createdTransactions  Transaction[]      @relation("TransactionCreator")
  approvedTransactions Transaction[]      @relation("TransactionApprover")
  createdLoans         Loan[]             @relation("LoanCreator")
  approvedLoans        Loan[]             @relation("LoanApprover")
  approvedClients      Client[]           @relation("ClientApprover")
  approvedAgents       Agent[]            @relation("AgentApprover")
  openedSessions       DailySession[]     @relation("SessionOpener")
  closedSessions       DailySession[]     @relation("SessionCloser")
  closures             DailyClosure[]
  auditLogs            AuditLog[]
  pushSubscriptions    PushSubscription[]

  // Communication relations
  conversationParticipations ConversationParticipant[]
  sentMessages               Message[]

  @@index([invitedByUserId])
  @@index([roleId])
  @@index([status])
  @@index([username])
  @@index([roleId, status])
}

model UserRole {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String               @unique
  description     String?
  isTrashed       Boolean              @default(false)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  isProtected     Boolean              @default(false)
  isDefault       Boolean              @default(false)
  users           User[]
  permissions     UserRolePermission[]
}

model UserPermission {
  id              String               @id @default(uuid())
  slug            String               @unique
  name            String
  description     String?
  createdByUserId String?
  createdAt       DateTime             @default(now())
  roles           UserRolePermission[]
}

model UserRolePermission {
  id           String         @id @default(uuid())
  roleId       String
  permissionId String
  assignedAt   DateTime       @default(now())
  permission   UserPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         UserRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "provider_providerAccountId")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SystemLog {
  id          String   @id @default(uuid())
  userId      String
  createdAt   DateTime @default(now())
  entityId    String?
  entityType  String?
  event       String?
  description String?
  ipAddress   String?
  meta        String?
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

model SystemSetting {
  id                             String   @id @default(uuid())
  name                           String   @default("My Company")
  logo                           String?
  active                         Boolean  @default(true)
  address                        String?
  websiteURL                     String?
  supportEmail                   String?
  supportPhone                   String?
  language                       String   @default("en")
  timezone                       String   @default("UTC")
  currency                       String   @default("USD")
  currencyFormat                 String   @default("$ {value}")
  socialFacebook                 String?
  socialTwitter                  String?
  socialInstagram                String?
  socialLinkedIn                 String?
  socialPinterest                String?
  socialYoutube                  String?
  notifyStockEmail               Boolean  @default(true)
  notifyStockWeb                 Boolean  @default(true)
  notifyStockThreshold           Int      @default(10)
  notifyStockRoleIds             String[]
  notifyNewOrderEmail            Boolean  @default(true)
  notifyNewOrderWeb              Boolean  @default(true)
  notifyNewOrderRoleIds          String[]
  notifyOrderStatusUpdateEmail   Boolean  @default(true)
  notifyOrderStatusUpdateWeb     Boolean  @default(true)
  notifyOrderStatusUpdateRoleIds String[]
  notifyPaymentFailureEmail      Boolean  @default(true)
  notifyPaymentFailureWeb        Boolean  @default(true)
  notifyPaymentFailureRoleIds    String[]
  notifySystemErrorFailureEmail  Boolean  @default(true)
  notifySystemErrorWeb           Boolean  @default(true)
  notifySystemErrorRoleIds       String[]
}

enum UserStatus {
  INACTIVE
  ACTIVE
  BLOCKED
}

// ============================================
// Microfinance Management System Models
// ============================================

// Collection Areas (Zones)
model CollectionArea {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  city        String?
  region      String?
  status      AreaStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?

  clients          Client[]
  agentAssignments AgentAreaAssignment[]
  agents           Agent[]               @relation("AgentCollectionArea")
  transactions     Transaction[]

  @@index([code])
  @@index([status])
}

enum AreaStatus {
  ACTIVE
  INACTIVE
}

// Financial Accounts (separate from NextAuth Account)
model FinancialAccount {
  id                 String        @id @default(uuid())
  accountNumber      String        @unique
  accountType        AccountType
  accountNatureId    String?
  balance            Decimal       @default(0) @db.Decimal(19, 4)
  availableBalance   Decimal       @default(0) @db.Decimal(19, 4)
  status             AccountStatus @default(ACTIVE)
  openedAt           DateTime      @default(now())
  closedAt           DateTime?
  blockedUntil       DateTime?
  maturityDate       DateTime?
  customInterestRate Decimal?      @db.Decimal(5, 4)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  accountNature AccountNature? @relation(fields: [accountNatureId], references: [id])
  client        Client?
  agent         Agent?
  transactions  Transaction[]
  loans         Loan[]

  @@index([accountNumber])
  @@index([accountType])
  @@index([accountNatureId])
  @@index([status])
  @@index([accountType, status])
}

enum AccountType {
  CLIENT
  AGENT
  SYSTEM
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum MaintenanceFeeType {
  MONTHLY
  INITIAL
}

// Account Nature (reference config - 12 account types)
model AccountNature {
  id                     String              @id @default(uuid())
  code                   String              @unique
  name                   String
  description            String?
  minBalance             Decimal?            @db.Decimal(19, 4)
  minOpeningContribution Decimal?            @db.Decimal(19, 4)
  interestRateDefault    Decimal?            @db.Decimal(5, 4)
  interestRateMin        Decimal?            @db.Decimal(5, 4)
  interestRateMax        Decimal?            @db.Decimal(5, 4)
  interestRateNegotiable Boolean             @default(false)
  maintenanceFee         Decimal?            @db.Decimal(19, 4)
  maintenanceFeeType     MaintenanceFeeType?
  transactionFee         Decimal?            @db.Decimal(19, 4)
  transactionFeeVariable Boolean             @default(false)
  openingFee             Decimal?            @db.Decimal(19, 4)
  isBlocked              Boolean             @default(false)
  blockedDurationMonths  Int?
  minTermMonths          Int?
  isActive               Boolean             @default(true)
  sortOrder              Int                 @default(0)
  allowDeposit           Boolean             @default(true)
  allowWithdrawal        Boolean             @default(true)
  allowTransfer          Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  accounts          FinancialAccount[]
  requiredDocuments AccountNatureDocument[]

  @@index([code])
  @@index([isActive])
}

// Document types for account creation requirements
model DocumentType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  accountNatures AccountNatureDocument[]
}

// Which documents are required per account nature
model AccountNatureDocument {
  id              String  @id @default(uuid())
  accountNatureId String
  documentTypeId  String
  isRequired      Boolean @default(true)

  accountNature AccountNature @relation(fields: [accountNatureId], references: [id], onDelete: Cascade)
  documentType  DocumentType  @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)

  @@unique([accountNatureId, documentTypeId])
  @@index([accountNatureId])
  @@index([documentTypeId])
}

// Loan products (Green Credit, etc.)
model LoanProduct {
  id                       String   @id @default(uuid())
  code                     String   @unique
  name                     String
  maxAmount                Decimal  @db.Decimal(19, 4)
  maxDurationDays          Int
  interestRate             Decimal  @db.Decimal(5, 4)
  minDailyCollectionMonths Int?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  loans Loan[]

  @@index([code])
  @@index([isActive])
}

// Clients
model Client {
  id                 String         @id @default(uuid())
  clientNumber       String         @unique
  userId             String?        @unique
  fullName           String
  nationalId         String?
  phone              String?
  email              String?
  address            String?
  city               String?
  areaId             String
  agentId            String?
  accountId          String         @unique
  status             ClientStatus   @default(ACTIVE)
  isCommissionExempt Boolean        @default(false)
  documentChecklist  Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdBy          String?
  updatedBy          String?
  approvalStatus     ApprovalStatus @default(APPROVED)
  approvedBy         String?
  approvedAt         DateTime?

  area          CollectionArea   @relation(fields: [areaId], references: [id])
  account       FinancialAccount @relation(fields: [accountId], references: [id])
  assignedAgent Agent?           @relation("ClientAgent", fields: [agentId], references: [id])
  transactions  Transaction[]
  loans         Loan[]
  commissions   Commission[]
  creator       User?            @relation("ClientCreator", fields: [createdBy], references: [id])
  updater       User?            @relation("ClientUpdater", fields: [updatedBy], references: [id])
  approver      User?            @relation("ClientApprover", fields: [approvedBy], references: [id])

  @@index([clientNumber])
  @@index([areaId])
  @@index([agentId])
  @@index([status])
  @@index([status, areaId])
  @@index([areaId, status])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

enum ApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// Agents
model Agent {
  id               String         @id @default(uuid())
  agentCode        String         @unique
  userId           String         @unique
  fullName         String
  nationalId       String?
  phone            String?
  email            String?
  address          String?
  accountId        String         @unique
  status           AgentStatus    @default(ACTIVE)
  hireDate         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdBy        String?
  updatedBy        String?
  city             String?
  approvalStatus   ApprovalStatus @default(APPROVED)
  approvedBy       String?
  approvedAt       DateTime?
  collectionAreaId String?

  user            User                  @relation(fields: [userId], references: [id])
  collectionArea  CollectionArea?       @relation("AgentCollectionArea", fields: [collectionAreaId], references: [id])
  account         FinancialAccount      @relation(fields: [accountId], references: [id])
  areaAssignments AgentAreaAssignment[]
  assignedClients Client[]              @relation("ClientAgent")
  transactions    Transaction[]
  creator         User?                 @relation("AgentCreator", fields: [createdBy], references: [id])
  updater         User?                 @relation("AgentUpdater", fields: [updatedBy], references: [id])
  approver        User?                 @relation("AgentApprover", fields: [approvedBy], references: [id])

  @@index([agentCode])
  @@index([status])
  @@index([collectionAreaId])
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model AgentAreaAssignment {
  id         String   @id @default(uuid())
  agentId    String
  areaId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())
  assignedBy String?

  agent Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  area  CollectionArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([agentId, areaId])
  @@index([agentId])
  @@index([areaId])
}

// Transactions
model Transaction {
  id                String            @id @default(uuid())
  transactionNumber String            @unique
  accountId         String
  type              TransactionType
  amount            Decimal           @db.Decimal(19, 4)
  balanceBefore     Decimal           @db.Decimal(19, 4)
  balanceAfter      Decimal           @db.Decimal(19, 4)
  status            TransactionStatus @default(PENDING_APPROVAL)
  description       String?
  reference         String?
  areaId            String?
  agentId           String?
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?
  rejectedReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  account       FinancialAccount @relation(fields: [accountId], references: [id])
  area          CollectionArea?  @relation(fields: [areaId], references: [id])
  agent         Agent?           @relation(fields: [agentId], references: [id])
  creator       User             @relation("TransactionCreator", fields: [createdBy], references: [id])
  approver      User?            @relation("TransactionApprover", fields: [approvedBy], references: [id])
  commission    Commission?
  auditLogs     AuditLog[]
  loanRepayment LoanRepayment?
  Client        Client?          @relation(fields: [clientId], references: [id])
  clientId      String?

  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([areaId])
  @@index([agentId])
  @@index([transactionNumber])
  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([accountId, createdAt(sort: Desc)], map: "Transaction_accountId_createdAt_desc_idx")
  @@index([agentId, createdAt(sort: Desc)])
  @@index([type, status, createdAt])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  COLLECTION
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  TRANSFER
  COMMISSION
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  REVERSED
}

// Loans
model Loan {
  id               String     @id @default(uuid())
  loanNumber       String     @unique
  accountId        String
  clientId         String
  principalAmount  Decimal    @db.Decimal(19, 4)
  interestRate     Decimal    @db.Decimal(5, 4)
  totalAmount      Decimal    @db.Decimal(19, 4)
  remainingBalance Decimal    @db.Decimal(19, 4)
  status           LoanStatus @default(PENDING)
  loanProductId    String?
  purpose          String?
  disbursedAt      DateTime?
  maturityDate     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?

  account     FinancialAccount @relation(fields: [accountId], references: [id])
  client      Client           @relation(fields: [clientId], references: [id])
  loanProduct LoanProduct?     @relation(fields: [loanProductId], references: [id])
  creator     User             @relation("LoanCreator", fields: [createdBy], references: [id])
  approver    User?            @relation("LoanApprover", fields: [approvedBy], references: [id])
  repayments  LoanRepayment[]

  @@index([loanProductId])
  @@index([loanNumber])
  @@index([accountId])
  @@index([clientId])
  @@index([status])
  @@index([status, clientId])
  @@index([status, createdAt])
  @@index([clientId, status, maturityDate])
  @@index([createdBy, status])
}

enum LoanStatus {
  PENDING
  APPROVED
  DISBURSED
  ACTIVE
  PAID_OFF
  DEFAULTED
  CANCELLED
}

model LoanRepayment {
  id            String   @id @default(uuid())
  loanId        String
  transactionId String   @unique
  amount        Decimal  @db.Decimal(19, 4)
  principal     Decimal  @db.Decimal(19, 4)
  interest      Decimal  @db.Decimal(19, 4)
  repaidAt      DateTime @default(now())

  loan        Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([loanId])
  @@index([loanId, repaidAt(sort: Desc)])
  @@index([repaidAt])
}

// Commissions
model Commission {
  id                String   @id @default(uuid())
  transactionId     String   @unique
  clientId          String
  amount            Decimal  @db.Decimal(19, 4)
  rate              Decimal  @db.Decimal(5, 4)
  calculationMethod String
  period            String
  calculatedAt      DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([period])
  @@index([calculatedAt])
}

// Daily Sessions & Closures
model DailySession {
  id          String        @id @default(uuid())
  sessionDate DateTime      @unique @db.Date
  status      SessionStatus @default(OPEN)
  openedAt    DateTime      @default(now())
  closedAt    DateTime?
  openedBy    String?
  closedBy    String?

  opener  User?         @relation("SessionOpener", fields: [openedBy], references: [id])
  closer  User?         @relation("SessionCloser", fields: [closedBy], references: [id])
  closure DailyClosure?

  @@index([sessionDate])
  @@index([status])
}

enum SessionStatus {
  OPEN
  CLOSED
  LOCKED
}

model DailyClosure {
  id               String   @id @default(uuid())
  sessionId        String   @unique
  closureDate      DateTime @db.Date
  totalCollections Decimal  @default(0) @db.Decimal(19, 4)
  totalWithdrawals Decimal  @default(0) @db.Decimal(19, 4)
  totalDeposits    Decimal  @default(0) @db.Decimal(19, 4)
  physicalCash     Decimal? @db.Decimal(19, 4)
  systemBalance    Decimal  @db.Decimal(19, 4)
  surplusShortage  Decimal  @default(0) @db.Decimal(19, 4)
  notes            String?
  closedBy         String
  closedAt         DateTime @default(now())

  session DailySession @relation(fields: [sessionId], references: [id])
  closer  User         @relation(fields: [closedBy], references: [id])

  @@index([closureDate])
}

// Audit Logs (enhanced version)
model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  entityType    String
  entityId      String?
  transactionId String?
  changes       Json?
  ipAddress     String?
  userAgent     String?
  description   String?
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([action])
}

// ============================================
// Communication Models
// ============================================

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  attachments   Json?    // [{ path, filename, mimeType }]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt])
}
