# Database Configuration
POSTGRES_PASSWORD=postgres

# Next.js & Next Auth
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=ZGNtLWRldi1zZWNyZXQtY2hhbmdlLWluLXByb2R1Y3Rpb24tMzJjaGFycw==

# API & Base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_BASE_PATH=http://localhost:3001/

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Storage Configuration (AWS S3 or DigitalOcean Spaces)
STORAGE_TYPE=digitalocean
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_REGION=ams3
STORAGE_BUCKET=your_bucket_name
STORAGE_ENDPOINT=your_endpoint
STORAGE_FORCE_PATH_STYLE=true
STORAGE_CDN_URL=your_cdn_url

# SMTP Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@domain.com
SMTP_PASS=your_smtp_password
SMTP_SENDER=Metronic
SMTP_FROM=no-reply@domain.com

# reCAPTCHA (Optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Web Push VAPID Keys (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key

# Commission Cron (Self-hosted only)
ENABLE_COMMISSION_CRON=0
CRON_SECRET=your_cron_secret_here

# Base URL
BASE_URL=/

# Show dev credentials on login page (for local Docker testing)
NEXT_PUBLIC_SHOW_DEV_CREDENTIALS=1
